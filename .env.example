   # Copy this file to .env.local:   cp .env.example .env.local
   # .env.local is git-ignored; this example file IS committed on purpose.
   # For the local demo there is nothing to configure: the default below is the
   # address the app already uses.

   # Base URL of the bia.backend REST API, including the /api prefix.
   # Default when unset: http://localhost:3001/api
   #
   # CAVEAT for this revision: this value has NO effect in the browser today. The
   # client always falls back to the default above, because the lookup in
   # src/utils/apiBaseUrl.ts uses the dynamic optional-chained form
   # (`process?.env?.NEXT_PUBLIC_API_URL`) that Next does not statically inline. It
   # is documented as a defect, not as a feature, in docs/frontend-guide.md §4.
   NEXT_PUBLIC_API_URL=http://localhost:3001/api